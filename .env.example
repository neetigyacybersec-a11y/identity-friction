# Copy to .env and fill in what you need. Never commit .env.
# Every value here is optional. With an empty .env the project still runs in demo mode
# and still produces deterministic detections. Only the model-backed layers go quiet.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# "demo" reads synthetic events from data/sample/. "live" reads from a real tenant.
MODE=demo

# SQLite file. The repo ignores *.db, so this never gets committed.
DATABASE_PATH=data/entra_defense.db

# ---------------------------------------------------------------------------
# Microsoft Entra ID / Microsoft Graph  (live mode only)
# ---------------------------------------------------------------------------
# From your app registration in the Entra admin centre.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# How far back a collection looks. Graph refuses unfiltered sign-in queries, so
# every collection is bounded by a time range built from this.
GRAPH_LOOKBACK_HOURS=24

# Page size for Graph. Max is 1000; 100 is a safe, fast default.
GRAPH_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# System One — JEV decision layer
# ---------------------------------------------------------------------------
# JEV runs through OpenRouter. See docs/adr/0001 for why it is not the native
# typesafe-sdk, and what that costs.
OPENROUTER_API_KEY=
JEV_MODEL_NAME=typesafe/jev-router

# Confidence bands. The floor catches everything the model is unsure about; the
# high threshold is the bar an incident must clear to skip the LLM second read.
JEV_HIGH_CONFIDENCE=0.80
JEV_MEDIUM_CONFIDENCE=0.60

# ---------------------------------------------------------------------------
# System Two — LLM investigation layer
# ---------------------------------------------------------------------------
# Any small model on OpenRouter. Must return JSON.
LLM_MODEL_NAME=openai/gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200

# ---------------------------------------------------------------------------
# Detection thresholds
# ---------------------------------------------------------------------------
# Every threshold lives here rather than inline in a detector, because each one
# encodes a judgement about what is normal. Those judgements are meant to be argued with.

# Password spray: many failures, many users, one source, short window.
SPRAY_FAILED_LOGIN_THRESHOLD=10
SPRAY_UNIQUE_USER_THRESHOLD=5
SPRAY_WINDOW_MINUTES=10

# MFA fatigue: repeated MFA denials, then a success. The success is what makes
# it interesting — it means the push got through.
MFA_FAILURE_THRESHOLD=3
MFA_WINDOW_MINUTES=15
MFA_SUCCESS_LOOKAHEAD_MINUTES=10

# Geographically anomalous authentication. 900 km/h is roughly the fastest
# commercial aircraft; anything above it is not a person travelling.
IMPOSSIBLE_TRAVEL_SPEED_KMH=900
IMPOSSIBLE_TRAVEL_LOOKBACK_HOURS=24
# Below this great-circle distance, geolocation noise alone can explain a jump.
IMPOSSIBLE_TRAVEL_MIN_DISTANCE_KM=200

# Suspicious OAuth consent. A list, because the exact activity names are
# tenant- and licence-dependent. Verify these against your own audit log.
OAUTH_SUSPICIOUS_ACTIVITIES=Consent to application,Add delegated permission grant,Add member to role,Add eligible member to role,Add scoped member to role
# Delegated permissions that are worth flagging on sight when combined with a
# new consent grant. Comma-separated, like every other list in this file.
OAUTH_SENSITIVE_SCOPES=Mail.Read,Mail.ReadWrite,Files.ReadWrite.All,Directory.ReadWrite.All,User.ReadWrite.All,offline_access,Application.ReadWrite.All,RoleManagement.ReadWrite.Directory

# ---------------------------------------------------------------------------
# Incident correlation
# ---------------------------------------------------------------------------
# Candidates whose events fall within this window of each other may join the
# same incident. Generous, because identity attacks unfold over minutes.
INCIDENT_WINDOW_MINUTES=60
